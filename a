
import numpy as np
import matplotlib.pyplot as plt

# ACTIVIDAD: TRANSFORMADA DE FOURIER

# 1. Crear el tiempo
fs = 200
t = np.arange(-1, 1, 1/fs)
N = len(t)

# 2. Crear tres señales
seno = np.sin(2*np.pi*5*t)
pulso = np.where(np.abs(t) <= 0.2, 1, 0)
escalon = np.where(t >= 0, 1, 0)

# 3. Analizar cada señal
def graficar(t, senal, nombre):
    transformada = np.fft.fft(senal)
    frecuencia = np.fft.fftfreq(N, 1/fs)

    # Ordenar las frecuencias de menor a mayor
    transformada = np.fft.fftshift(transformada)
    frecuencia = np.fft.fftshift(frecuencia)

    magnitud = np.abs(transformada)/N
    fase = np.angle(transformada)

    plt.figure(figsize=(9, 7))

    plt.subplot(3, 1, 1)
    plt.plot(t, senal)
    plt.title(nombre + " - Dominio del tiempo")
    plt.xlabel("Tiempo (s)")
    plt.ylabel("Amplitud")
    plt.grid()

    plt.subplot(3, 1, 2)
    plt.plot(frecuencia, magnitud)
    plt.title("Espectro de magnitud")
    plt.xlabel("Frecuencia (Hz)")
    plt.ylabel("Magnitud")
    plt.xlim(-30, 30)
    plt.grid()

    plt.subplot(3, 1, 3)
    plt.plot(frecuencia, fase)
    plt.title("Espectro de fase")
    plt.xlabel("Frecuencia (Hz)")
    plt.ylabel("Fase (radianes)")
    plt.xlim(-30, 30)
    plt.grid()

    plt.tight_layout()
    plt.show()

# 4. Mostrar las gráficas
graficar(t, seno, "Señal senoidal de 5 Hz")
graficar(t, pulso, "Pulso rectangular")
graficar(t, escalon, "Función escalón")

# 5. Propiedad de linealidad
a = 2
b = 3
otra_senal = np.cos(2*np.pi*10*t)

resultado1 = np.fft.fft(a*seno + b*otra_senal)
resultado2 = a*np.fft.fft(seno) + b*np.fft.fft(otra_senal)

error = np.max(np.abs(resultado1 - resultado2))

print("VERIFICACIÓN DE PROPIEDADES")
print("Error de linealidad:", error)
print("La linealidad se cumple si el error es cercano a cero.")

# 6. Desplazamiento temporal
retraso = 0.1
seno_retrasado = np.sin(2*np.pi*5*(t-retraso))

plt.figure(figsize=(9, 4))
plt.plot(t, seno, label="Señal original")
plt.plot(t, seno_retrasado, "--", label="Señal retrasada")
plt.title("Desplazamiento en el tiempo")
plt.xlabel("Tiempo (s)")
plt.ylabel("Amplitud")
plt.legend()
plt.grid()
plt.show()

# 7. Escalamiento temporal
seno_comprimido = np.sin(2*np.pi*10*t)

plt.figure(figsize=(9, 4))
plt.plot(t, seno, label="Original: 5 Hz")
plt.plot(t, seno_comprimido, label="Comprimida: 10 Hz")
plt.title("Escalamiento temporal")
plt.xlabel("Tiempo (s)")
plt.ylabel("Amplitud")
plt.legend()
plt.grid()
plt.show()

print("Simulación terminada.")
